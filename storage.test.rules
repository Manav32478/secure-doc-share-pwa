rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // IMPORTANT: These are TEST MODE rules for development only!
    // For production, use the rules in storage.rules
    
    // Allow all authenticated users to read/write
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
      allow write: if request.resource.size < 50 * 1024 * 1024; // 50MB limit
    }
  }
}
